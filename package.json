{
  "name": "apuracao-comandas",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema web para apuracao mensal de comandas escolares.",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "dev:netlify": "netlify dev",
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "backup:prod": "node scripts/backup_supabase.js",
    "backup:audit": "node scripts/audit_backup_recovery.js",
    "backup:restore-items": "node scripts/restore_backup_items.js",
    "routes:preview": "node scripts/preview_route_assignments.js",
    "routes:apply": "node scripts/apply_route_assignments.js --apply",
    "seed": "python scripts/import_seed.py",
    "export": "python scripts/export_consolidated.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "exceljs": "^4.4.0",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=18"
  }
}
